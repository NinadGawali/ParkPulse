# Rendered by the nginx image entrypoint (envsubst over the ${VARS} set in the environment).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    include /etc/nginx/conf.d/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API through the gateway (same origin, so the browser needs no CORS).
    location /api/ {
        proxy_pass ${GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 30s;
    }
    # Only the admin API: /admin pages belong to the SPA.
    location /admin/v1/ {
        proxy_pass ${GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
    location /.well-known/ {
        proxy_pass ${GATEWAY_URL};
        proxy_set_header Host $host;
    }

    # Presigned uploads to the local S3-compatible store, which sends no CORS headers. The signature covers
    # the Host header, so the signed host is sent upstream unchanged. Real S3 is called directly (CORS rule).
    location /_storage/ {
        rewrite ^/_storage/(.*)$ /$1 break;
        proxy_pass ${STORAGE_URL};
        proxy_set_header Host ${STORAGE_SIGNED_HOST};
        proxy_request_buffering off;
        client_max_body_size 11m;
    }

    # Hashed build assets never change.
    location /assets/ {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: unknown paths get index.html, which is never cached.
    location / {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
