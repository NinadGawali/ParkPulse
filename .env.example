# Copy to .env and fill in local-only values. Never commit .env.
# Used by: docker compose --env-file .env -f infra/docker-compose.yml up -d

# --- Postgres (one container, one database + role per service) ---
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
IDENTITY_DB_PASSWORD=
PROFILE_DB_PASSWORD=
LISTING_DB_PASSWORD=
BOOKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
REVIEW_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
SEARCH_DB_PASSWORD=

# --- Kafka (KRaft) ---
KAFKA_PORT=9092

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=

# --- S3-compatible object storage (local stand-in for S3) ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PHOTOS_BUCKET=parksmart-listing-photos

# --- OpenSearch (only with --profile search) ---
OPENSEARCH_PORT=9200

# --- Identity Service ---
# Secret key for hashing verification codes and tokens (>= 32 chars).
IDENTITY_CODE_PEPPER=
# RSA private key (PKCS#8 PEM) for signing JWTs. Optional locally (an ephemeral key is generated);
# required on aws. Leave commented out locally.
# IDENTITY_JWT_PRIVATE_KEY_PEM=
